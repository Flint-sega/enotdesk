ENOT_HOST=
ENOT_PORT=
ENOT_DB=
ENOT_PUBLIC_URL=
ENOT_TURN_URLS=
ENOT_TURN_USERNAME=
ENOT_TURN_PASSWORD=

# deploy-server.sh: развёртывание на сервер (ENOT_DEPLOY_HOST обязателен)
ENOT_DEPLOY_HOST=
# SSH-пользователь (по умолчанию root) и порт (по умолчанию 22)
ENOT_DEPLOY_USER=
ENOT_DEPLOY_PORT=
# Протокол внешнего health-URL: http (по умолчанию) или https
ENOT_DEPLOY_PROTO=
# Пароль SSH: пусто — вход по ключу; задан — нужен sshpass
ENOT_DEPLOY_PASSWORD=

# smoke-remote.mjs: проверка развёрнутого сервера
ENOT_ADMIN_LOGIN=
ENOT_ADMIN_PASSWORD=

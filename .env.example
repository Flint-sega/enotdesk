ENOT_HOST=
ENOT_PORT=
ENOT_DB=
# Каталог сборок для страницы /downloads (по умолчанию <cwd>/dist)
ENOT_DIST_DIR=
ENOT_PUBLIC_URL=
ENOT_TURN_URLS=
ENOT_TURN_USERNAME=
ENOT_TURN_PASSWORD=
# Секрет coturn (use-auth-secret): задан — /rtc-config раздаёт ЭФЕМЕРНЫЕ креды
# (coturn REST API style, TTL 1 час), статические ENOT_TURN_USERNAME/PASSWORD не раздаются.
ENOT_TURN_SECRET=
# Доверенные обратные прокси: IP или IPv4-CIDR через запятую (например 127.0.0.1,::1).
# Пусто — X-Forwarded-For не доверяется никому, лимиты считаются по адресу сокета.
ENOT_TRUSTED_PROXY=
# Грейс на переподключение участника в сеансе, мс (по умолчанию 30000; 0 — завершать сразу)
ENOT_GRACE_MS=
# Сколько дней хранить завершённые сеансы (по умолчанию 90; 0 — хранить вечно)
ENOT_RETENTION_DAYS=
# Потолок живых (WS) сеансов на сервере (по умолчанию 200)
ENOT_MAX_SESSIONS=
# Ключ шифрования секретов (2FA и др.): 64 hex-символа / base64-32байта / любая строка (приводится к 32 байтам).
# Без ключа включение 2FA честно отказывает; значение никогда не попадает в ответы и журнал.
ENOT_SECRET_KEY=

# deploy-server.sh: развёртывание на сервер (ENOT_DEPLOY_HOST обязателен)
ENOT_DEPLOY_HOST=
# SSH-пользователь (по умолчанию root) и порт (по умолчанию 22)
ENOT_DEPLOY_USER=
ENOT_DEPLOY_PORT=
# Протокол внешнего health-URL: http (по умолчанию) или https
ENOT_DEPLOY_PROTO=
# Пароль SSH: пусто — вход по ключу; задан — нужен sshpass
ENOT_DEPLOY_PASSWORD=

# smoke-remote.mjs: проверка развёрнутого сервера
ENOT_ADMIN_LOGIN=
ENOT_ADMIN_PASSWORD=

# ── docker compose (docker/README.md) ──
# Публичный домен сервера: HTTPS включится сам (Caddy/Let's Encrypt), TURN получит этот адрес.
# Пусто — честный HTTP-режим на :80 с предупреждением в логах.
DOMAIN=
# Секрет TURN-сервера (coturn, use-auth-secret): длинная случайная строка, обязателен для compose.
# В argv процессов не попадает: coturn пишет его в /run/turnserver.conf (0600, tmpfs) внутри контейнера,
# сервер получает его же переменной ENOT_TURN_SECRET (эфемерные TURN-креды, см. выше).
TURN_SECRET=
# Имя пользователя TURN (в compose); по умолчанию 2000000000 — метка 2033-05-18 UTC
# (coturn читает её как 32-битное число, больше 2147483647 не подходит).
# Пароль вычисляется из TURN_SECRET автоматически (docker/enotdesk/entrypoint.sh), вручную не задавай.
TURN_USERNAME=

# ── EnotDesk Hub (тикет-система + чат; опционально) ──
# Внутренний порт хаба (по умолчанию 8090; наружу отдаётся через Caddy)
ENOT_HUB_PORT=
# Адрес EnotDesk для SSO-логина и health (в compose: http://enotdesk:8080)
ENOTDESK_URL=
# Публичный адрес хаба, как его видит браузер (https://домен); https включает
# Secure у cookie сессии. Пусто — берётся из DOMAIN/ENOT_PUBLIC_URL
HUB_URL=
# Включить сервис hub в compose (HUB=1; quick-setup ставит сам) и добавить
# его маршруты в Caddy: /hub/, /widget.js, /w, /join, /api/hub/*
HUB=
# COMPOSE_PROFILES=hub активирует профиль сервиса hub (ставится при HUB=1)
COMPOSE_PROFILES=

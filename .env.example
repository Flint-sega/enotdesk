ENOT_HOST=
ENOT_PORT=
ENOT_DB=
# Каталог сборок для страницы /downloads (по умолчанию <cwd>/dist)
ENOT_DIST_DIR=
ENOT_PUBLIC_URL=
ENOT_TURN_URLS=
ENOT_TURN_USERNAME=
ENOT_TURN_PASSWORD=
# Грейс на переподключение участника в сеансе, мс (по умолчанию 30000; 0 — завершать сразу)
ENOT_GRACE_MS=
# Сколько дней хранить завершённые сеансы (по умолчанию 90; 0 — хранить вечно)
ENOT_RETENTION_DAYS=
# Потолок живых (WS) сеансов на сервере (по умолчанию 200)
ENOT_MAX_SESSIONS=

# deploy-server.sh: развёртывание на сервер (ENOT_DEPLOY_HOST обязателен)
ENOT_DEPLOY_HOST=
# SSH-пользователь (по умолчанию root) и порт (по умолчанию 22)
ENOT_DEPLOY_USER=
ENOT_DEPLOY_PORT=
# Протокол внешнего health-URL: http (по умолчанию) или https
ENOT_DEPLOY_PROTO=
# Пароль SSH: пусто — вход по ключу; задан — нужен sshpass
ENOT_DEPLOY_PASSWORD=

# smoke-remote.mjs: проверка развёрнутого сервера
ENOT_ADMIN_LOGIN=
ENOT_ADMIN_PASSWORD=

# ── docker compose (docker/README.md) ──
# Публичный домен сервера: HTTPS включится сам (Caddy/Let's Encrypt), TURN получит этот адрес.
# Пусто — честный HTTP-режим на :80 с предупреждением в логах.
DOMAIN=
# Секрет TURN-сервера (coturn, use-auth-secret): длинная случайная строка, обязателен для compose
TURN_SECRET=
# Имя пользователя TURN (в compose); по умолчанию 2000000000 — метка 2033-05-18 UTC
# (coturn читает её как 32-битное число, больше 2147483647 не подходит).
# Пароль вычисляется из TURN_SECRET автоматически (docker/enotdesk/entrypoint.sh), вручную не задавай.
TURN_USERNAME=

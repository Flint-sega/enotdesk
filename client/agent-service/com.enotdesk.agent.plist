<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  EnotDesk agent - LaunchAgent (macOS, ADR 0038).
  Ставится в ~/Library/LaunchAgents/com.enotdesk.agent.plist пользователя Mac
  (install-macos.sh, без sudo). Работает в графическом сеансе пользователя
  (LimitLoadToSessionType=Aqua): только там macOS даёт захват экрана и ввод.
  Пока никто не вошёл в систему, агент не запущен — экран входа macOS
  вне рамок 1.0 (ADR 0037). Путь и имя машины подставляет install-macos.sh.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.enotdesk.agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Applications/EnotDesk.app/Contents/MacOS/EnotDesk</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>EDESK_AGENT</key>
        <string>1</string>
        <key>EDESK_AGENT_NAME</key>
        <string>mac-mini</string>
    </dict>

    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- Логи агента (stdout/stderr) - путь подставляет install-macos.sh -->
    <key>StandardOutPath</key>
    <string>/tmp/enotdesk-agent.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/enotdesk-agent.log</string>
</dict>
</plist>

{
  "name": "enotdesk",
  "version": "0.6.28",
  "description": "EnotDesk — portable удалённая поддержка (клиент запускается без установки)",
  "private": true,
  "type": "module",
  "author": "EnotDesk",
  "main": "client/main.mjs",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "server": "node server/main.mjs",
    "start": "electron client/main.mjs",
    "bootstrap": "node server/main.mjs bootstrap",
    "test": "node --test \"server/test/*.test.mjs\" \"client/test/*.test.mjs\" \"hub/test/*.test.mjs\"",
    "lint": "eslint .",
    "smoke:local": "node scripts/smoke-local.mjs",
    "load": "node scripts/load-test.mjs",
    "icons": "node scripts/make-icons.mjs",
    "pack:mac": "electron-builder --config build/electron-builder.yml --mac",
    "pack:win": "electron-builder --config build/electron-builder.yml --win",
    "pack:linux": "electron-builder --config build/electron-builder.yml --linux"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "imapflow": "2.5.8",
    "koffi": "3.3.3",
    "nodemailer": "10.1.7",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "eslint": "10.13.0",
    "globals": "17.13.0"
  }
}

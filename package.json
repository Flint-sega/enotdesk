{
  "name": "enotdesk",
  "version": "0.1.0",
  "description": "EnotDesk — portable удалённая поддержка (клиент запускается без установки)",
  "private": true,
  "type": "module",
  "author": "EnotDesk",
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "server": "node server/main.mjs",
    "start": "electron desktop/main.mjs",
    "bootstrap": "node server/main.mjs bootstrap",
    "test": "node --test \"server/test/*.test.mjs\" \"desktop/test/*.test.mjs\"",
    "smoke:local": "node scripts/smoke-local.mjs",
    "icons": "node scripts/make-icons.mjs",
    "pack:mac": "electron-builder --mac",
    "pack:win": "electron-builder --win",
    "pack:linux": "electron-builder --linux"
  },
  "dependencies": {
    "koffi": "3.2.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.enotdesk.app",
    "productName": "EnotDesk",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "artifactName": "EnotDesk-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns",
      "identity": null
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    }
  }
}
